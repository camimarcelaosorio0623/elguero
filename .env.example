# Copia este archivo como .env.local para desarrollo. NUNCA pongas secretos aquí:
# todo lo que empieza por VITE_ termina dentro del JavaScript público del navegador.

# Fuente de datos: "mock" (demo, datos de prueba) o "http" (API de Agent.IA).
VITE_DATA_SOURCE=mock

# URL base de la API de Agent.IA (solo cuando VITE_DATA_SOURCE=http). Sin barra final.
VITE_API_BASE_URL=

# Número oficial de WhatsApp en formato internacional sin "+" (ej. 57XXXXXXXXXX).
# Vacío = el botón se ve pero usa el número provisional 570000000000 (inválido a propósito).
# PENDIENTE: poner el número oficial antes del lanzamiento.
VITE_WHATSAPP_NUMBER=

# URL pública del sitio (para metadatos sociales y canonical).
VITE_SITE_URL=https://elgueropro.netlify.app
